{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "setback-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "setback-planner.paperplane.builders",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setback-planner-production",
      "database_id": "dea6f4fe-48a5-4d0e-b00e-dccf008a44f3",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "AI_ENABLED": "true",
    "AI_DAILY_LIMIT": "20",
    "TURNSTILE_SITEKEY": "0x4AAAAAAGDxHm-Xx-flQooh"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "setback-planner-staging",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": [
          "/api/*"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "setback-planner-staging",
          "database_id": "a828b1da-9d5a-4983-9466-d47b88cf335c",
          "migrations_dir": "migrations"
        }
      ],
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "vars": {
        "AI_ENABLED": "true",
        "AI_DAILY_LIMIT": "10",
        "TURNSTILE_SITEKEY": "0x4AAAAAAGDxHm-Xx-flQooh"
      },
      "triggers": {
        "crons": [
          "47 3 * * *"
        ]
      }
    }
  }
}
