{
  "name": "setback-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p backend.config.json",
    "lint": "eslint public tests worker",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test:production": "npm run build && PLAYWRIGHT_PREVIEW=1 playwright test --grep \"map loads attributed|3D supports camera|SVG export and printable|catalog photos|workspace navigation|mobile library|window editor|first visit leads|identifier search previews|address ambiguity|phone confirmation|leaving the wide\"",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.187.0",
    "@types/wellknown": "^0.5.8",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "clipper-lib": "^6.4.2",
    "maplibre-gl": "^6.18.0",
    "pbf": "^5.1.2",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.23.0",
    "qrcode": "^1.5.4",
    "suncalc": "^2.1.4",
    "three": "^0.187.0",
    "wellknown": "^0.5.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
